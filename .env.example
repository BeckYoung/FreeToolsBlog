# 后端 API 地址（留空则使用同源）
VITE_API_BASE_URL=

# 是否禁用浏览器右键菜单（true / false）
VITE_DISABLE_CONTEXT_MENU=false

# 【本地开发】接入真实后端（Cloudflare Pages 部署地址）。
# 由 vite.config.ts 读取并做同源代理转发，可绕开浏览器跨域限制；
# 留空则使用内置的本地 Mock API（支持注册/登录，账号存 .local-dev-api/users.json）。
# 例：LOCAL_API_TARGET=https://your-site.pages.dev
LOCAL_API_TARGET=
